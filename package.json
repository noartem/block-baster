{
  "name": "block-baster-tools",
  "private": true,
  "description": "Browser tests and media capture for the web build of Block Baster (the game itself is Rust, see Cargo.toml)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "./scripts/build-web.sh",
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
